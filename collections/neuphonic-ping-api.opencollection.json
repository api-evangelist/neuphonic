{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neuphonic Agents Ping API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neuphonic.com/ping"
          },
          "docs": "Health check endpoint to verify the API is reachable."
        }
      ]
    }
  ],
  "bundled": true
}