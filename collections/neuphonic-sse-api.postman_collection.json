        {
          "id": "1c629e02-081f-41f4-8251-394bf3067815",
          "name": "SSE Text-to-Speech",
          "request": {
            "name": "SSE Text-to-Speech",
            "description": {
              "content": "Generate speech from text using Server-Sent Events (SSE) streaming. Returns a real-time audio stream in PCM format. Supports language selection, voice selection, speed control, and sampling rate configuration. Sub-25ms latency for the first audio chunk.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sse",
                "speak",
                ":lang_code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "API key for authentication."
                },
                {
                  "disabled": false,
                  "key": "jwt_token",
                  "value": "<string>",
                  "description": "JWT token obtained from /sse/auth for faster authentication."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lang_code",
                  "description": "(Required) Language code for the speech synthesis (e.g., en, es, de, fr, ur, ja, ko, zh, pt).\n"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "API key in the X-API-KEY header.",
                "key": "X-API-KEY",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"<string>\",\n  \"voice\": \"<string>\",\n  \"speed\": \"<float>\",\n  \"sampling_rate\": \"<integer>\"\n}",
              "options": {
